# Frontend (Vite) environment variables.
# Copy to .env for local dev: cp .env.example .env

# REQUIRED IN PRODUCTION.
# Set this in the Vercel dashboard (Project -> Settings -> Environment Variables)
# and REDEPLOY. VITE_* vars are inlined at build time, so they take effect on
# the next build, not at runtime.
# Use your Render backend URL with no trailing slash and no /api suffix,
# e.g. https://squadup-api.onrender.com
# Without it the deployed bundle falls back to http://localhost:5000, which
# does not exist for your visitors.
VITE_API_URL=http://localhost:5000

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_WEATHER_API_KEY=
VITE_MAPBOX_TOKEN=
