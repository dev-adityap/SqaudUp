# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/squadup

# Google Gemini
GEMINI_API_KEY=

# Firebase Admin (Service Account) - required for requireAuth middleware
# Private key must keep its literal \n sequences, or use quoted multiline.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
